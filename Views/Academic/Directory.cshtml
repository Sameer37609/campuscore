@inject LocalWriteAccess WriteAccess
@model DirectoryPage
@{ViewData["Title"]=Model.Kind; var noun=Model.Kind=="Students"?"student":Model.Kind=="Courses"?"course":"enrollment";}
<section class="page-heading"><div><div class="eyebrow">ACADEMIC WORKSPACE</div><h1>@Model.Kind<span class="heading-dot">.</span></h1><p>@(Model.Kind=="Students"?"The people at the heart of your campus.":Model.Kind=="Courses"?"Explore the curriculum. Understand every seat.":"Every student. Every course. One connected view.")</p></div><span class="heading-count">@Model.AllCount <small>fictional records</small></span></section>
<section class="panel directory-panel" aria-label="@Model.Kind directory"><div class="panel-heading"><div><h2>@Model.Kind directory</h2><p>Browse records and open a detailed view.</p></div>@if(WriteAccess.Allows(Context)){<a class="btn btn-primary" href="/@Model.Kind/Create">@(Model.Kind=="Students"?"New student":Model.Kind=="Courses"?"New course":"Enroll student")</a>}else{<span class="soft-label">Read-only workspace</span>}</div>
<form method="get" class="filter-form" role="search"><div class="search-field"><label for="q">Search @Model.Kind.ToLowerInvariant()</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="@(Model.Kind=="Enrollments"?"Student, course or record ID…":"Name, email or code…")" maxlength="150"/></div><div><label for="department">Department</label><select class="form-select" name="department" id="department"><option value="">All departments</option>@foreach(var d in Model.Departments){<option selected="@(Model.Department==d)" value="@d">@d</option>}</select></div><div><label for="status">Status</label><select class="form-select" name="status" id="status"><option value="">All statuses</option>@foreach(var s in Model.Statuses){<option selected="@(Model.Status==s)" value="@s">@s</option>}</select></div><div><label for="year">@(Model.Kind=="Students"?"Academic year":"Term & year")</label><select class="form-select" name="year" id="year"><option value="">All</option>@foreach(var y in Model.Years){<option selected="@(Model.Year==y)" value="@y">@y</option>}</select></div><div><label for="sort">Sort by</label><select class="form-select" name="sort" id="sort">@foreach(var s in new[]{("name","Name A–Z"),("name-desc","Name Z–A"),("id","Record ID"),("department","Department")}){<option selected="@(Model.Sort==s.Item1)" value="@s.Item1">@s.Item2</option>}</select></div><div class="filter-actions"><button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-light" href="/@Model.Kind">Reset</a></div></form>
<div class="results-line" role="status"><span><strong>@Model.Total</strong> matching @(Model.Total==1?noun:noun+"s")</span><span>Page @Model.Page of @Model.Pages</span></div>
@if(Model.Total==0){<div class="empty-state"><span class="empty-symbol" aria-hidden="true">⌕</span><h2>No @Model.Kind.ToLowerInvariant() found</h2><p>Try a different search or clear a filter to see more records.</p><a href="/@Model.Kind" class="btn btn-primary">Clear filters</a></div>}else{
<div class="table-wrap" tabindex="0" role="region" aria-label="@Model.Kind records"><table class="academic-table"><caption class="visually-hidden">@Model.Kind matching the current filters</caption><thead><tr><th scope="col">@(Model.Kind=="Enrollments"?"Student / course":Model.Kind=="Students"?"Student":"Course")</th><th scope="col">Record ID</th><th scope="col">Department</th><th scope="col">@(Model.Kind=="Students"?"Year":"Term")</th><th scope="col">Status</th><th scope="col">@(Model.Kind=="Courses"?"Capacity":Model.Kind=="Students"?"Course load":"Result")</th><th scope="col"><span class="visually-hidden">Details</span></th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><div class="person-cell"><span class="avatar" aria-hidden="true">@row.Initials</span><div><a class="record-title" href="@row.Url">@row.Title</a><small>@row.Subtitle</small></div></div></td><td class="record-id" data-label="Record ID">@row.Id</td><td data-label="Department">@row.Department</td><td data-label="Year / term">@row.Year</td><td data-label="Status"><span class="badge-status @row.Status.ToLowerInvariant().Replace(" ","-")">@row.Status</span></td><td data-label="@(Model.Kind=="Courses"?"Capacity":Model.Kind=="Students"?"Course load":"Result")"><span>@row.Detail</span>@if(row.Capacity is not null){<progress class="table-progress" max="@row.Capacity" value="@row.Occupied" aria-label="@row.Title capacity">@row.Detail</progress>}</td><td data-label="Details"><a class="arrow-link" href="@row.Url" aria-label="View @row.Id">↗</a></td></tr>}</tbody></table></div>
<div class="pagination-line"><span>Showing @((Model.Page-1)*10+1)–@(Math.Min(Model.Page*10,Model.Total)) of @Model.Total</span><nav aria-label="Directory pages">@if(Model.Page>1){<a class="btn btn-light" asp-action="Index" asp-route-q="@Model.Q" asp-route-department="@Model.Department" asp-route-status="@Model.Status" asp-route-year="@Model.Year" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page-1)">← Previous</a>}<span class="page-number" aria-current="page">@Model.Page</span>@if(Model.Page<Model.Pages){<a class="btn btn-light" asp-action="Index" asp-route-q="@Model.Q" asp-route-department="@Model.Department" asp-route-status="@Model.Status" asp-route-year="@Model.Year" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page+1)">Next →</a>}</nav></div>}
</section><p class="directory-footnote">@(AppMode.IsPublicDemo?"Fictional sample records · Read-only portfolio demo.":"Academic records · Local SQL workspace.")</p>
