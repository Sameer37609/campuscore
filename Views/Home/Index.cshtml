@model IAcademicData
@using System.Globalization
@{ ViewData["Title"]="Dashboard";
 var current=Model.Enrollments.Where(e=>e.Term==Model.CurrentTerm&&e.AcademicYear==Model.CurrentYear).ToArray();
 var active=current.Count(e=>e.Status=="Enrolled"); var seats=Model.Courses.Where(c=>c.Status=="Active").Sum(c=>c.Capacity);
 var months=Model.Enrollments.GroupBy(e=>new{e.EnrolledOn.Year,e.EnrolledOn.Month}).OrderBy(g=>g.Key.Year).ThenBy(g=>g.Key.Month).ToArray();
 var max=months.Length==0?1:months.Max(g=>g.Count());
 var points=string.Join(" ",months.Select((g,i)=>$"{(40+i*480d/Math.Max(1,months.Length-1)).ToString("0.0",CultureInfo.InvariantCulture)},{(175-g.Count()*135d/max).ToString("0.0",CultureInfo.InvariantCulture)}"));
 var departments=Model.Students.GroupBy(s=>s.Department).OrderBy(g=>g.Key).ToArray();
}
<section class="page-heading"><div><div class="eyebrow">YOUR CAMPUS, AT A GLANCE</div><h1>Academic overview<span class="heading-dot">.</span></h1><p>A clearer view of your academic community.</p></div><a class="btn btn-primary" href="/Students">Explore students <span aria-hidden="true">↗</span></a></section>
<div class="term-banner"><div><span class="live-dot" aria-hidden="true"></span><strong>@Model.CurrentTerm @Model.CurrentYear</strong><span class="banner-divider">|</span><span>Academic snapshot</span></div><span>@(AppMode.IsPublicDemo?"Fictional academic snapshot":"Illustrative term · local dataset")</span></div>
<section class="kpi-grid" aria-label="Academic metrics">
@foreach(var k in new[]{("Total students",Model.Students.Count.ToString(),$"Across {Model.Students.Select(s=>s.Department).Distinct().Count()} departments","students"),("Active courses",Model.Courses.Count(c=>c.Status=="Active").ToString(),"Available in the course catalog","courses"),("Total enrollments",Model.Enrollments.Count.ToString(),"All terms · includes completed","enrollments"),("Current seat utilization",$"{(seats==0?0:Math.Round(active*100d/seats))}%",$"{active} enrolled / {seats} available seats","overview")}) {<article class="kpi"><div class="kpi-top"><span>@k.Item1</span><svg aria-hidden="true"><use href="/icons.svg#@k.Item4"/></svg></div><div class="kpi-value">@k.Item2</div><div class="kpi-note"><span class="tiny-dot" aria-hidden="true"></span>@k.Item3</div></article>}
</section>
<div class="dashboard-charts"><section class="panel trend-panel"><div class="panel-heading"><div><h2>Enrollment activity</h2><p>New registrations by month · all statuses</p></div><span class="soft-label">@Model.CurrentYear</span></div><div class="chart-legend"><span class="legend-dot"></span> Registration records <strong>@Model.Enrollments.Count total</strong></div>
<figure class="trend-figure"><svg class="trend-chart" viewBox="0 0 560 220" role="img" aria-labelledby="trend-title trend-desc"><title id="trend-title">Monthly enrollment registrations</title><desc id="trend-desc">@string.Join("; ",months.Select(g=>$"{new DateOnly(g.Key.Year,g.Key.Month,1):MMM yyyy}: {g.Count()}"))</desc><path class="chart-grid" d="M40 40H520 M40 85H520 M40 130H520 M40 175H520"/>@if(months.Length>1){<polygon class="chart-fill" points="40,175 @points 520,175"/><polyline class="chart-line" points="@points"/>}@for(var i=0;i<months.Length;i++){var x=(40+i*480d/Math.Max(1,months.Length-1)).ToString("0.0",CultureInfo.InvariantCulture);var y=(175-months[i].Count()*135d/max).ToString("0.0",CultureInfo.InvariantCulture);<g><circle class="chart-point" cx="@x" cy="@y" r="4"/><text x="@x" y="205" text-anchor="middle">@(new DateOnly(months[i].Key.Year,months[i].Key.Month,1).ToString("MMM"))</text><text x="@x" y="@(double.Parse(y,CultureInfo.InvariantCulture)-13)" text-anchor="middle" class="chart-number">@months[i].Count()</text></g>}</svg><figcaption>@(months.Length==0?"No registrations recorded yet.":"Months with registrations are shown. Counts include historical and current records.")</figcaption></figure></section>
<section class="panel"><div class="panel-heading"><div><h2>Our academic community</h2><p>Students by department</p></div><span class="soft-label">@Model.Students.Count students</span></div><svg class="department-stack" viewBox="0 0 @Math.Max(1,Model.Students.Count) 4" preserveAspectRatio="none" role="img" aria-label="@string.Join(", ",departments.Select(g=>$"{g.Key}: {g.Count()}"))">@for(var i=0;i<departments.Length;i++){<rect x="@departments.Take(i).Sum(g=>g.Count())" y="0" width="@departments[i].Count()" height="4" class="segment-@i"/>}</svg><div class="department-list">@if(departments.Length==0){<p class="form-help">No students recorded yet.</p>}@for(var i=0;i<departments.Length;i++){var g=departments[i];<div><span><i class="department-dot segment-@i"></i>@g.Key</span><strong>@g.Count() <small>@Math.Round(g.Count()*100d/Model.Students.Count)%</small></strong></div>}</div><a class="text-link" href="/Students">View student directory <span aria-hidden="true">→</span></a></section></div>
<div class="dashboard-bottom"><section class="panel"><div class="panel-heading"><div><h2>Recent enrollments</h2><p>Latest registrations across the campus</p></div><a class="text-link" href="/Enrollments">View all →</a></div><partial name="_Rows" model="Model.Enrollments.OrderByDescending(e=>e.EnrolledOn).ThenByDescending(e=>e.Id).Take(5).Select(Model.EnrollmentRow).ToArray()"/></section>
<section class="panel"><div class="panel-heading"><div><h2>Course capacity</h2><p>@Model.CurrentTerm @Model.CurrentYear · enrolled students only</p></div><a class="text-link" href="/Courses">Catalog →</a></div><div class="capacity-list">@foreach(var c in Model.Courses.Where(c=>c.Status=="Active").OrderByDescending(c=>Model.Occupied(c.Id)*1d/c.Capacity).Take(4)){var count=Model.Occupied(c.Id);<div><div class="capacity-label"><a href="/Courses/Details/@c.Id">@c.Title</a><span>@count <small>/ @c.Capacity</small></span></div><progress value="@count" max="@c.Capacity" aria-label="@c.Title capacity">@count of @c.Capacity</progress><small>@c.Code · @c.Department</small></div>}</div></section></div>
<div class="demo-note"><svg aria-hidden="true"><use href="/icons.svg#info"/></svg><span><strong>Built for exploration.</strong> @(AppMode.IsPublicDemo?"All people and academic records shown here are fictional. Explore the dashboard and directories; this demo does not save changes.":"Metrics reflect saved local records. Changes are available only in explicitly enabled local development.")</span></div>
